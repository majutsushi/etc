#!/usr/bin/env bash
# Author:       {{ g:user_name }} <{{ g:user_email }}>
# Created:      {{ strftime('%Y-%m-%d %H:%M:%S %z %Z') }}
# Last changed: {{ strftime('%Y-%m-%d %H:%M:%S %z %Z') }}

set -eEu -o pipefail
shopt -s inherit_errexit
IFS=$'\n\t'
PS4="$BASH_SOURCE:"'+\t '

trap 'echo "$0: Error on line ${LINENO}: $BASH_COMMAND" >&2' ERR

[[ "${TRACE:-0}" == "1" ]] && set -x
